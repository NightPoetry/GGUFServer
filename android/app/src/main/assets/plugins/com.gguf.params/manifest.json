{
  "id": "com.gguf.params",
  "name": "参数导演",
  "version": "1.0.1",
  "apiVersion": 1,
  "description": "按任务类型自动选择采样参数：写作用高温、代码计算用近贪心、聊天用官方推荐档+DRY 防复读",
  "author": "gguf",
  "entry": {
    "ui": "ui.html",
    "service": "service.js"
  },
  "panel": {
    "size": 0.5
  },
  "settingsCard": "settings.html",
  "permissions": [
    "llm",
    "chat:params",
    "chat:external"
  ],
  "hooks": [
    "params"
  ],
  "middleware": {
    "scope": [
      "local",
      "external"
    ]
  }
}
