{
  "id": "com.gguf.relay",
  "name": "外援",
  "version": "1.0.0",
  "apiVersion": 1,
  "description": "本机模型答不好的活，交给外部 API 顶上：接管插件发起的推理调用（作曲、判断、摘要…），OpenAI 兼容端点自己填。默认关闭——一旦打开，这些内容会离开这台手机",
  "author": "gguf",
  "entry": {
    "ui": "ui.html",
    "service": "service.js"
  },
  "panel": {
    "size": 0.6
  },
  "settingsCard": "settings.html",
  "permissions": [
    "llm",
    "cap:llm",
    "net:internet",
    "net:lan"
  ],
  "provides": [
    "llm"
  ],
  "hooks": [
    "llm"
  ]
}
